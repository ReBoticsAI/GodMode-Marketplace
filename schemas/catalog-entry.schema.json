{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ReBoticsAI/GodMode-Marketplace/schemas/catalog-entry.schema.json",
  "title": "GodModeCatalogEntry",
  "type": "object",
  "required": ["id", "kind", "installType", "title", "description", "version", "author"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": {
      "enum": [
        "bundle",
        "plugin",
        "skill",
        "agent",
        "page",
        "workflow",
        "artifact",
        "rule",
        "knowledge",
        "dataset"
      ]
    },
    "installType": { "enum": ["clone", "plugin"] },
    "deliveryMode": {
      "enum": ["clone", "live"],
      "description": "How buyers receive the listing. clone = portable copy; live = Shared grant on seller host. Default clone."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "author": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "bundlePath": { "type": "string" },
    "pluginRepo": { "type": "string", "format": "uri" },
    "pluginRef": { "type": "string", "minLength": 1 },
    "pluginDigest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$",
      "description": "Expected git commit SHA after checkout (buyer Bridge pin check)"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "Aggregate SHA-256 of verified build artifacts from intake CI"
    },
    "ciRunUrl": {
      "type": "string",
      "format": "uri",
      "description": "Green GitHub Actions run URL for this pluginRef (reusable-plugin-verify)"
    },
    "previewPath": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "installType": { "const": "clone" } },
        "required": ["installType"]
      },
      "then": {
        "required": ["bundlePath"],
        "not": {
          "anyOf": [
            { "required": ["artifactSha256"] },
            { "required": ["ciRunUrl"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "installType": { "const": "plugin" } },
        "required": ["installType"]
      },
      "then": {
        "required": ["pluginRepo", "pluginRef"],
        "not": { "required": ["bundlePath"] }
      }
    },
    {
      "if": {
        "properties": { "deliveryMode": { "const": "live" } },
        "required": ["deliveryMode"]
      },
      "then": {
        "properties": {
          "installType": { "const": "clone" }
        },
        "required": ["installType", "bundlePath", "pluginRepo", "pluginRef"]
      }
    }
  ],
  "additionalProperties": false
}
